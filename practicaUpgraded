import sys
if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stdin.reconfigure(encoding="utf-8")

import re
from concurrent.futures import ThreadPoolExecutor

import nltk
from nltk.chat.util import Chat, reflections

pairs = [
    [r'.*привет.*|.*здравствуй.*|.*добрый день.*',
     ['Привет!', 'Здравствуйте!', 'Добрый день!', 'Приветствую!']],
    [r'.*как тебя (зовут|называют).*',
     ['Меня зовут SynergyBot. А тебя?']],
    [r'.*меня зовут (.*)',
     ['Приятно познакомиться, %1!', 'Здравствуйте, %1!']],
    [r'.*как дела.*',
     ['У меня всё хорошо!', 'Прекрасно, а у вас?']],
    [r'.*что ты умеешь.*',
     ['Отвечаю на вопросы про поступление, программы, стоимость, практику и контакты.']],
    [r'.*поступ.*|.*документ.*|.*при[её]мн.*|.*срок.*',
     ['Для поступления нужны паспорт, аттестат и заявление. Сроки — в приёмной комиссии.']],
    [r'.*стоимост.*|.*цен[аы].*|.*оплат.*|.*сколько стоит.*',
     ['Стоимость зависит от программы. Уточняйте на сайте или в приёмной комиссии.']],
    [r'.*программ.*|.*специальн.*|.*направлен.*|.*факультет.*',
     ['Бизнес, IT, экономика, менеджмент, маркетинг, психология и др.']],
    [r'.*контакт.*|.*телефон.*|.*адрес.*|.*почт.*',
     ['Контакты — на официальном сайте «Синергии».']],
    [r'.*практик.*|.*стажир.*',
     ['Практику организует вуз с партнёрами. Обратитесь к куратору или в деканат.']],
    [r'.*\bпока\b.*|.*до свидания.*|.*до встречи.*',
     ['До свидания!', 'До встречи!', 'Пока!']],
]

TOPICS = {
    "поступление": "документы паспорт аттестат заявление комиссия сроки подать поступить",
    "программы":   "направления специальности факультеты программы обучение учиться",
    "стоимость":   "цена оплата стоимость платно бюджет",
    "контакты":    "телефон адрес почта связаться контакты",
    "практика":    "стажировка куратор деканат практика",
}

def words(text):
    return re.findall(r"[а-яa-z]+", text.lower().replace("ё", "е"))

def score_topic(text, keywords):
    return len(set(words(text)) & set(keywords.split()))

def fallback(text):
    with ThreadPoolExecutor() as pool:
        results = pool.map(
            lambda item: (item[0], score_topic(text, item[1])),
            TOPICS.items(),
        )
    topic, score = max(results, key=lambda x: x[1])
    return topic if score >= 1 else None

def start_chat():
    chat = Chat(pairs, reflections)

    while True:
        msg = input("Вы: ").strip()
        if not msg:
            continue
        if msg.lower() in ("выход", "quit", "exit"):
            print("Бот: До свидания!")
            break

        resp = chat.respond(msg)
        if resp is None:
            topic = fallback(msg)
            resp = (
                f"Похоже, вы про «{topic}». Уточните вопрос, пожалуйста."
                if topic else
                "Не понял. Спросите про поступление, программы, стоимость, практику или контакты."
            )
        print("Бот:", resp)

if __name__ == '__main__':
    start_chat()
